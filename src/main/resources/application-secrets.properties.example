# Copy this file to application-secrets.properties and fill in your own values.
# application-secrets.properties is git-ignored, so credentials never reach the repository.
spring.datasource.username=YOUR_SQL_SERVER_USERNAME
spring.datasource.password=YOUR_SQL_SERVER_PASSWORD
spring.mail.username=YOUR_GMAIL_ADDRESS
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
# only used with the "mysql" profile
MYSQL_USERNAME=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
